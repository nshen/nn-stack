{
  "extends": "@nn-stack/config/tsconfig.base.json",
  "compilerOptions": {
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "jsx": "preserve",
    "incremental": true,
    "noEmit": true,
    "paths": {
      "@/*": ["./*"],
      "@nn-stack/ui/*": ["./src/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", "alchemy.run.ts"],
  "exclude": ["node_modules"]
}
