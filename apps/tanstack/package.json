{
  "name": "@nn-stack/tanstack",
  "type": "module",
  "scripts": {
    "dev": "alchemy dev --env-file .local.env",
    "build": "vite build",
    "deploy:dev": "alchemy deploy --stage dev --env-file .dev.env",
    "deploy:prod": "alchemy deploy --stage prod --env-file .prod.env",
    "destroy:dev": "alchemy destroy --stage dev",
    "destroy:prod": "alchemy destroy --stage prod",
    "lint": "biome lint --write",
    "format": "biome format --write"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.2.8",
