{
  "name": "nn-stack",
  "type": "module",
  "version": "1.0.0",
  "scripts": {
    "dev": "pnpm -r dev",
    "deploy:dev": "pnpm run -r deploy:dev",
    "deploy:prod": "pnpm run -r deploy:prod",
    "destroy:dev": "pnpm run -r destroy:dev",
    "destroy:prod": "pnpm run -r destroy:prod",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter @nn-stack/tanstack run test:e2e",
    "typecheck": "pnpm -r typecheck",
    "ci": "biome ci",
    "lint": "biome lint .",
    "format": "biome check --write .",
    "sync:secrets": "bash scripts/sync-secrets.sh"
  },
  "description": "",
  "keywords": [],
  "author": "nshen<nshen121@gmail.com>",
  "license": "MIT",
  "packageManager": "pnpm@10.24.0",
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "alchemy": "catalog:",
    "ctx7": "^0.3.9",
    "wrangler": "catalog:"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd"
    ]
  }
}
